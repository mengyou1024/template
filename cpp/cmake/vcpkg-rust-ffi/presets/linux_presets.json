{
    "version": 6,
    "configurePresets": [
        {
            "name": "linux-gcc-base",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                {% if enable_test -%}
                "BUILD_TESTING": "ON",
                {% endif -%}
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "gcc-x64-static",
            "hidden": true,
            "inherits": "linux-gcc-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux"
            }
        },
        {
            "name": "gcc-x64-dynamic",
            "hidden": true,
            "inherits": "linux-gcc-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
            }
        },
        {
            "name": "gcc-x64-static-dbg",
            "displayName": "Linux GCC x64 Static Debug",
            "inherits": "gcc-x64-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-x64-static-rel",
            "displayName": "Linux GCC x64 Static Release",
            "inherits": "gcc-x64-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "gcc-x64-dynamic-dbg",
            "displayName": "Linux GCC x64 Dynamic Debug",
            "inherits": "gcc-x64-dynamic",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "gcc-x64-dynamic-rel",
            "displayName": "Linux GCC x64 Dynamic Release",
            "inherits": "gcc-x64-dynamic",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-x64-static-dbg-build",
            "displayName": "Build Linux GCC Static Debug",
            "configurePreset": "gcc-x64-static-dbg",
            "description": "Build Linux GCC x64 Static Debug configuration"
        },
        {
            "name": "gcc-x64-static-rel-build",
            "displayName": "Build Linux GCC Static Release",
            "configurePreset": "gcc-x64-static-rel",
            "description": "Build Linux GCC x64 Static Release configuration"
        },
        {
            "name": "gcc-x64-dynamic-dbg-build",
            "displayName": "Build Linux GCC Dynamic Debug",
            "configurePreset": "gcc-x64-dynamic-dbg",
            "description": "Build Linux GCC x64 Dynamic Debug configuration"
        },
        {
            "name": "gcc-x64-dynamic-rel-build",
            "displayName": "Build Linux GCC Dynamic Release",
            "configurePreset": "gcc-x64-dynamic-rel",
            "description": "Build Linux GCC x64 Dynamic Release configuration"
        }
    ],
    "testPresets": [
        {
            "name": "gcc-x64-static-dbg-test",
            "displayName": "Test Linux GCC Static Debug",
            "configurePreset": "gcc-x64-static-dbg",
            "description": "Run tests for Linux GCC x64 Static Debug configuration"
        },
        {
            "name": "gcc-x64-static-rel-test",
            "displayName": "Test Linux GCC Static Release",
            "configurePreset": "gcc-x64-static-rel",
            "description": "Run tests for Linux GCC x64 Static Release configuration"
        },
        {
            "name": "gcc-x64-dynamic-dbg-test",
            "displayName": "Test Linux GCC Dynamic Debug",
            "configurePreset": "gcc-x64-dynamic-dbg",
            "description": "Run tests for Linux GCC x64 Dynamic Debug configuration"
        },
        {
            "name": "gcc-x64-dynamic-rel-test",
            "displayName": "Test Linux GCC Dynamic Release",
            "configurePreset": "gcc-x64-dynamic-rel",
            "description": "Run tests for Linux GCC x64 Dynamic Release configuration"
        }
    ],
    "packagePresets": [
        {
            "name": "gcc-x64-static-dbg-package",
            "displayName": "Package Linux GCC Static Debug",
            "configurePreset": "gcc-x64-static-dbg",
            "description": "Create package for Linux GCC x64 Static Debug configuration"
        },
        {
            "name": "gcc-x64-static-rel-package",
            "displayName": "Package Linux GCC Static Release",
            "configurePreset": "gcc-x64-static-rel",
            "description": "Create package for Linux GCC x64 Static Release configuration"
        },
        {
            "name": "gcc-x64-dynamic-dbg-package",
            "displayName": "Package Linux GCC Dynamic Debug",
            "configurePreset": "gcc-x64-dynamic-dbg",
            "description": "Create package for Linux GCC x64 Dynamic Debug configuration"
        },
        {
            "name": "gcc-x64-dynamic-rel-package",
            "displayName": "Package Linux GCC Dynamic Release",
            "configurePreset": "gcc-x64-dynamic-rel",
            "description": "Create package for Linux GCC x64 Dynamic Release configuration"
        }
    ],
    "workflowPresets": [
        {
            "name": "gcc-x64-static-dbg-workflow",
            "displayName": "Workflow Linux GCC Static Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "gcc-x64-static-dbg"
                },
                {
                    "type": "build",
                    "name": "gcc-x64-static-dbg-build"
                },
                {
                    "type": "test",
                    "name": "gcc-x64-static-dbg-test"
                },
                {
                    "type": "package",
                    "name": "gcc-x64-static-dbg-package"
                }
            ]
        },
        {
            "name": "gcc-x64-static-rel-workflow",
            "displayName": "Workflow Linux GCC Static Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "gcc-x64-static-rel"
                },
                {
                    "type": "build",
                    "name": "gcc-x64-static-rel-build"
                },
                {
                    "type": "test",
                    "name": "gcc-x64-static-rel-test"
                },
                {
                    "type": "package",
                    "name": "gcc-x64-static-rel-package"
                }
            ]
        },
        {
            "name": "gcc-x64-dynamic-dbg-workflow",
            "displayName": "Workflow Linux GCC Dynamic Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "gcc-x64-dynamic-dbg"
                },
                {
                    "type": "build",
                    "name": "gcc-x64-dynamic-dbg-build"
                },
                {
                    "type": "test",
                    "name": "gcc-x64-dynamic-dbg-test"
                },
                {
                    "type": "package",
                    "name": "gcc-x64-dynamic-dbg-package"
                }
            ]
        },
        {
            "name": "gcc-x64-dynamic-rel-workflow",
            "displayName": "Workflow Linux GCC Dynamic Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "gcc-x64-dynamic-rel"
                },
                {
                    "type": "build",
                    "name": "gcc-x64-dynamic-rel-build"
                },
                {
                    "type": "test",
                    "name": "gcc-x64-dynamic-rel-test"
                },
                {
                    "type": "package",
                    "name": "gcc-x64-dynamic-rel-package"
                }
            ]
        }
    ]
}