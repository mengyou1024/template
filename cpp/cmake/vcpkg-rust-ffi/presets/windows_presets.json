{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-msvc-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                {% if enable_test -%}
                "BUILD_TESTING": "ON",
                {% endif -%}
                {% if build_type == "lib" and library_type == "SHARED" -%}
                "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS": "ON",
                {% endif -%}
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-x64-md-dynamic",
            "hidden": true,
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "msvc-x64-md-static",
            "hidden": true,
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
            }
        },
        {
            "name": "msvc-x64-mt-static",
            "hidden": true,
            "inherits": "windows-msvc-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
            }
        },
        {
            "name": "msvc-x64-md-dynamic-dbg",
            "displayName": "MSVC x64 MD Dynamic Debug",
            "inherits": "msvc-x64-md-dynamic",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x64-md-dynamic-rel",
            "displayName": "MSVC x64 MD Dynamic Release",
            "inherits": "msvc-x64-md-dynamic",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-x64-md-static-dbg",
            "displayName": "MSVC x64 MD Static Debug",
            "inherits": "msvc-x64-md-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x64-md-static-rel",
            "displayName": "MSVC x64 MD Static Release",
            "inherits": "msvc-x64-md-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "msvc-x64-mt-static-dbg",
            "displayName": "MSVC x64 MT Static Debug",
            "inherits": "msvc-x64-mt-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "msvc-x64-mt-static-rel",
            "displayName": "MSVC x64 MT Static Release",
            "inherits": "msvc-x64-mt-static",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "msvc-x64-md-dynamic-dbg-build",
            "displayName": "Build MSVC MD Dynamic Debug",
            "configurePreset": "msvc-x64-md-dynamic-dbg",
            "description": "Build MSVC x64 MD Dynamic Debug configuration"
